APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
DATABASE_URL=postgresql+asyncpg://neondb_owner:REPLACE_ME@ep-xxx/neondb?sslmode=require

QDRANT_URL=https://REPLACE.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_ai_chunks

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=enterprise-ai-docs
OBJECT_STORAGE_BACKEND=firebase
OBJECT_STORAGE_PATH=./data/storage
FIREBASE_STORAGE_BUCKET=atmiya-db.appspot.com
FIREBASE_STORAGE_ROOT=resolve-ai
FIREBASE_CREDENTIALS_PATH=../../infra/secrets/firebase-adminsdk.json
# Or inline JSON for cloud deploy (keep secret):
# FIREBASE_CREDENTIALS_JSON=

OIDC_ISSUER=https://YOUR_TENANT.auth0.com/
OIDC_AUDIENCE=https://api.enterprise-ai-support.local
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
REGISTRATION_ENABLED=true
EMBEDDED_MOCKS_ENABLED=false
ALLOW_DEV_AUTH_IN_PRODUCTION=false
RUN_MIGRATIONS_ON_STARTUP=true
DEV_AUTH_ENABLED=true
DEV_AUTH_SECRET=dev-only-change-me-in-local

LLM_PRIMARY_PROVIDER=groq
LLM_PRIMARY_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=

LLM_FALLBACK_PROVIDER=gemini
LLM_FALLBACK_MODEL=
GEMINI_API_KEY=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

INTERNAL_JOB_SECRET=change-me-job-secret
INTERNAL_JOB_HMAC_KEY=change-me-hmac-key-32bytes-min!!

MAX_ANONYMOUS_MESSAGES_PER_DAY=5
MAX_AUTHENTICATED_MESSAGES_PER_DAY=20
MAX_GLOBAL_MODEL_CALLS_PER_DAY=700
MAX_MODEL_CALLS_PER_TURN=4
MAX_GRAPH_STEPS=8
MAX_OUTPUT_TOKENS=600

CRM_BASE_URL=http://localhost:8101
ERP_BASE_URL=http://localhost:8102
CARRIER_BASE_URL=http://localhost:8103
TICKETING_BASE_URL=http://localhost:8104
MOCK_SERVICE_TOKEN=mock-service-dev-token

SENTRY_DSN=
GIT_SHA=local
GRAPH_VERSION=v1
CORS_ORIGINS=http://localhost:3000

# Brevo transactional email (https://app.brevo.com)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=ResolveAI
EMAIL_ENABLED=true
# In dev, route all outbound mail to a verified inbox (demo users use .test emails)
EMAIL_FALLBACK_RECIPIENT=
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_REGISTRATION_ENABLED=true
NEXT_PUBLIC_DEV_AUTH_ENABLED=true
