# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.venv/
venv/
dist/
build/
*.egg-info/

# Env & secrets
.env
.env.local
.env.*.local
!.env.example
*.pem
credentials.json
*firebase-adminsdk*.json
infra/secrets/**
!infra/secrets/.gitkeep

# Node / Next
node_modules/
apps/web/.next/
apps/web/out/
.turbo/
*.tsbuildinfo

# IDE / OS
.DS_Store
.idea/
.vscode/
*.swp

# Data / local storage
data/storage/**
!data/storage/.gitkeep
data/seed/runtime/**

# Terraform
infra/terraform/.terraform/
*.tfstate*
*.tfvars

# Vercel / FastAPI Cloud local linkage
.vercel/
.fastapicloud/

# Logs / reports
*.log
evals/reports/*.json
!evals/reports/.gitkeep

# Generated vendor copies for FastAPI Cloud deploy (see scripts/prepare-fastapi-cloud.sh)
# Keep tracked for cloud uploads; regenerate with `bash scripts/prepare-fastapi-cloud.sh`
.vercel
.env*
